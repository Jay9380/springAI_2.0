<?xml version="1.0" encoding="UTF-8"?>
<!--
  스프링 AI 2.0 실습 저장소의 부모(parent) POM.

  - 책 『스프링 AI 2.0으로 배우는 AI 에이전트 개발 완벽 가이드』의 흐름을 장(chapter)별 모듈로 따라간다.
  - 모든 모듈이 같은 버전을 쓰도록 Spring Boot / Spring AI / Java 버전을 여기 한 곳에서만 정한다.
  - 각 장 모듈은 독립 실행 가능한 스프링 부트 앱이다. (예: ./mvnw -pl chapter01 spring-boot:run)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 스프링 AI 2.0은 Spring Boot 4.x가 필수다 (책 1.3.3, 표 1.1). 2.0.1은 Boot 4.1.1 기준으로 빌드되었다. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>kr.jay.springai</groupId>
    <artifactId>spring-ai-2-study</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-ai-2-study</name>
    <description>스프링 AI 2.0 장별 실습</description>

    <properties>
        <!-- 2.0은 Java 17 이상, 21 권장 (책 표 1.1) -->
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <!-- 장이 추가될 때마다 여기에 모듈을 하나씩 등록한다 -->
    <modules>
        <module>chapter01</module>
    </modules>

    <!--
      BOM(Bill Of Materials): spring-ai-* 라이브러리들의 버전을 한 번에 맞춰 준다.
      그래서 각 모듈에서는 스타터를 추가할 때 <version>을 적지 않는다.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
