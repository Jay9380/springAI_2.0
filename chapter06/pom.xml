<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 버전은 모두 부모 pom이 관리한다 -->
    <parent>
        <groupId>kr.jay.springai</groupId>
        <artifactId>spring-ai-2-study</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>chapter06</artifactId>
    <name>chapter06</name>
    <description>6장 - AI 에이전트 : 워크플로 패턴, 에이전트 루프, 컨텍스트 엔지니어링, 재귀 어드바이저, 스킬·하위 에이전트, 엔터프라이즈 에이전트 CLI</description>

    <dependencies>
        <!--
          Ollama 스타터 하나만 추가하면 자동설정이 다음 빈을 만들어 준다.
            - OllamaChatModel  : ChatModel 인터페이스의 Ollama 구현체 (HTTP JSON 변환 담당)
            - ChatClient.Builder : ChatClient를 만드는 빌더 (프로토타입 빈)
          버전은 부모 pom의 spring-ai-bom이 정한다.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
          [6.4] 에이전트의 외부 확장(MCP)과 사람 승인(Elicitation).
          한 모듈에 클라이언트·서버를 같이 두고 프로파일로 나눈다 (5장과 같은 방식).
            spring.profiles.active=ops-server : 운영 MCP 서버 (위험한 툴은 실행 전에 사람 승인을 요청)
            spring.profiles.active=agent      : 그 서버를 쓰는 에이전트 CLI
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!--
          [6.4.5] 동적 툴 탐색. 책은 스타터(spring-ai-starter-tool-search-advisor)를 쓰지만, 그 스타터의 자동 구성은
          spring.ai.chat.client.tool-search-advisor.enabled=true 하나로 '모든' ChatClient의 툴 루프를 바꿔 버린다.
          이 모듈은 다른 단계도 같이 있으므로 라이브러리만 넣고 어드바이저를 필요한 곳에서 직접 만든다.
          LuceneToolIndex는 lucene-core가 선택(optional) 의존성이라 직접 추가한다 (버전은 tool-search-tool 2.0.1 pom과 같게).
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tool-search-advisor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>9.12.3</version>
        </dependency>

        <!--
          [6.5 예제 6.21] 커뮤니티 에이전트 유틸: 스킬(SkillsTool), 명확화 질문(AskUserQuestionTool),
          작업 계획(TodoWriteTool), 하위 에이전트(TaskTool). 인큐베이팅 단계라 API가 바뀔 수 있다.
          책 기준 0.10.0을 쓴다. 0.10.0은 spring-ai 2.0.0으로 빌드되어 2.0.1에서 deprecated된 ToolCallAdvisor를 쓰지만,
          2.0.1에도 그 클래스가 (forRemoval) 남아 있어 동작한다. 0.11.0부터는 2.0.1 기준이다.
        -->
        <dependency>
            <groupId>org.springaicommunity</groupId>
            <artifactId>spring-ai-agent-utils</artifactId>
            <version>0.10.0</version>
        </dependency>

        <!-- [6.3.3 예제 6.13] 툴 루프 메트릭(카운터·분포). 버전은 스프링 부트가 관리한다 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
